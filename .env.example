# ── Legacy RAG Only ───────────────────────────────────────────────────────────
#
# Only set these if you intentionally revive code under archive/legacy-chat-rag.
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# LLM_PROVIDER=ollama

# ── Supabase Auth ──────────────────────────────────────────────────────────────
# JWT verification is done against the Supabase project's public JWKS endpoint
# (ES256 signing keys) — no shared secret needed. Only set SUPABASE_URL if you
# point the app at a different Supabase project than the built-in default.
# SUPABASE_URL=https://your-project-ref.supabase.co

# Only needed for local admin scripts (e.g. scripts/bulk_invite.py). Get it from
# Dashboard → Settings → API → service_role secret. Full admin power, bypasses
# RLS — never commit it, never use it in frontend/backend request-serving code.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Only needed for scripts/resend_pending_reminder.py. Get it from Resend
# Dashboard → API Keys → a Sending key (re_...). Never commit it.
# RESEND_API_KEY=your_resend_api_key_here
# RESEND_FROM_ADDRESS=UIUC Housing AI <hello@illinirent.com>  # optional, this is the default

# ── Local Frontend Dev ────────────────────────────────────────────────────────
#
# frontend/.env.local should point the Next.js proxy routes at the local FastAPI
# backend. Keep local repo ports in the 310x range to avoid collisions with
# other projects.
#
# BACKEND_URL=http://localhost:3101
# NEXT_PUBLIC_API_URL=http://localhost:3101
# NEXT_PUBLIC_SITE_URL=https://illinirent.com
